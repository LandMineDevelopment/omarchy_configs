{
  "manifest_version": 3,
  "name": "Brave Media Transparency Trial",
  "version": "0.2.54",
  "description": "Global media-aware transparency toggle. Images and videos are protected where supported.",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Turn media-aware transparency on or off globally"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "key": "",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "canvas-context.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "geometry.js",
        "media.js",
        "vendor/darkreader.js",
        "theme.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}

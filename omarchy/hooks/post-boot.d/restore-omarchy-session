#!/usr/bin/env bash
set -uo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-session"
latest="$state_dir/autosaves/latest.json"
log="$state_dir/post-boot-restore.log"

mkdir -p "$state_dir"
printf '\n[%s] post-boot restore\n' "$(date --iso-8601=seconds)" >>"$log"

# An autosave must never replace the previous session before it is restored.
systemctl --user stop omarchy-session-autosave.service >/dev/null 2>&1 || true

if [[ -e "$latest" ]]; then
  if timeout 120 "$HOME/.local/bin/omarchy-session" restore latest >>"$log" 2>&1; then
    notify-send "Workspace restored" "Restored the latest saved desktop session" >/dev/null 2>&1 || true
  else
    notify-send -u critical "Workspace restore needs review" "See $log" >/dev/null 2>&1 || true
  fi
  "$HOME/.local/bin/omarchy-session-restore-local-apps" >>"$log" 2>&1 || true
fi

# Watch for meaningful changes only after restoration has finished.
systemctl --user start omarchy-session-autosave.service

# Standalone Primary Space colors
background = #000000
foreground = #e6e6e6
cursor-color = #ffcc66
cursor-text = #0d0d0d
selection-background = #404040
selection-foreground = #e6e6e6
palette = 0=#262626
palette = 1=#e65c5c
palette = 2=#66cc66
palette = 3=#ffcc66
palette = 4=#6699ff
palette = 5=#cc66cc
palette = 6=#66cccc
palette = 7=#f2f2f2
palette = 8=#404040
palette = 9=#ff6666
palette = 10=#80e680
palette = 11=#ffdd80
palette = 12=#80b3ff
palette = 13=#e680e6
palette = 14=#80e6e6
palette = 15=#ffffff

font-family = "JetBrainsMono Nerd Font"
font-size = 9
window-padding-x = 14
window-padding-y = 14
window-decoration = none
confirm-close-surface = false
shell-integration = bash
shell-integration-features = no-cursor
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
mouse-scroll-multiplier = 0.95
async-backend = epoll

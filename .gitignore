# This repository lives in ~/.config. Ignore everything by default and only
# expose reviewed, portable configuration below. Never replace this with a
# broad allow rule: ~/.config also contains credentials and application state.
*

!.gitignore
!README.md
!bootstrap.sh
!components.conf
!configctl
!packages.txt
!lib/
!lib/components.sh
!profiles/
!profiles/**
!tests/
!tests/component-scoping.sh

!alacritty/
!alacritty/alacritty.toml

!autostart/
!autostart/*.desktop

!bash/
!bash/portable.bash

!btop/
!btop/btop.conf

!brave-flags.conf
!chromium-flags.conf

!fcitx5/
!fcitx5/profile
!fcitx5/conf/
!fcitx5/conf/clipboard.conf
!fcitx5/conf/notifications.conf
!fcitx5/conf/xcb.conf

!ghostty/
!ghostty/config

!git/
!git/config

!herdr/
!herdr/config.toml

!hypr/
!hypr/.luarc.json
!hypr/*.lua

!kitty/
!kitty/kitty.conf

!mimeapps.list

!mise/
!mise/config.toml

!nvim/
!nvim/**
nvim/tt.*
nvim/.tests
nvim/doc/tags
nvim/debug
nvim/.repro
nvim/foo.*
nvim/*.log
nvim/data

!omarchy/
!omarchy/defaults/
!omarchy/defaults/agent
!omarchy/extensions/
!omarchy/extensions/omarchy-menu.jsonc
!omarchy/shell.json
# Primary Space stays an independent repository. Deliberately do not allow
# omarchy/themes/ through the parent repository's deny-by-default boundary.
omarchy/themes/

!starship.toml

!system/
!system/**

!tmux/
!tmux/tmux.conf

!wireplumber/
!wireplumber/wireplumber.conf.d/
!wireplumber/wireplumber.conf.d/bluetooth-a2dp-autoconnect.conf

!xterm/
!xterm/Xresources

!yazi/
!yazi/**
